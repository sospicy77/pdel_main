            else:
                for j in range(0, len(result_bbs)):
                    t = 0
                    if result_df['tm'][i] == result_bbs[j]:
                        re_bbs.append(1)
                        t += 1
                        continue
                if t == 0:
                    re_bbs.append(" ")

            re_sbs.append(" ")

        result_df['bbs'] = re_bbs
        result_df['cms'] = re_cms
        result_df['cbs'] = re_cbs
        result_df['sbs'] = re_sbs

